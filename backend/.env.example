CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://agent_template:local-dev-only@127.0.0.1:5433/agent_template
LOG_LEVEL=INFO
# Optional. Set to http://127.0.0.1:4318 when running make backend-otel.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Entra External ID token validation. Values are pending tenant provisioning;
# leave all four blank (protected routes then return 503) or set all four.
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
OIDC_AUDIENCE=
OIDC_REQUIRED_SCOPE=
# Local development without Azure: run `make local-issuer`, then set the four
# OIDC_* values it prints (http://127.0.0.1:9000 issuer, api://local-dev
# audience, chat.use scope). The API still validates real signed tokens.
# Chat agent provider. "fake" is the deterministic local agent (no Azure).
AGENT_PROVIDER=fake
# Chat limits (defaults shown): message size, hard timeout, concurrency, rate.
# CHAT_MAX_MESSAGE_CHARS=4000
# CHAT_TIMEOUT_SECONDS=30
# CHAT_MAX_CONCURRENT_REQUESTS=5
# CHAT_RATE_LIMIT_PER_MINUTE=20
# Live Foundry (only with AGENT_PROVIDER=foundry; authenticates with
# DefaultAzureCredential: `az login` locally, managed identity in Azure).
# Both are required in that mode, otherwise the API refuses to start.
# FOUNDRY_PROJECT_ENDPOINT=https://ai-agent-template-dev.services.ai.azure.com/api/projects/proj-agent-template-dev
# FOUNDRY_DEPLOYMENT=chat
