VITE_API_BASE_URL=http://127.0.0.1:8000
# Entra External ID SPA registration. Values are pending tenant provisioning:
# leave all three blank (sign-in is disabled) or set all three.
# VITE_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>
# VITE_ENTRA_CLIENT_ID=<spa-application-client-id>
# VITE_API_SCOPES=api://<api-client-id>/<scope-name>
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_CLIENT_ID=
VITE_API_SCOPES=
# Opt-in local sign-in for manual development (dev server only, no Azure).
# Run `make local-issuer`, set this to the URL it prints, and leave the
# VITE_ENTRA_* values blank. Production builds refuse a non-blank value.
VITE_LOCAL_SIGNIN_URL=
